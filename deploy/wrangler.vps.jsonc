{
  "name": "aino-money",
  "main": "vps-worker.js",
  "compatibility_date": "2026-11-14",
  "workers_dev": true,
  "assets": {
    "directory": "../frontend/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "vpc_services": [
    {
      "binding": "AINO_MONEY_ORIGIN",
      "service_id": "01a1da0a-5177-7d01-92c5-d063b93e5d5a"
    }
  ]
}
