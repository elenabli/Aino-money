# --- Option A: OpenRouter (cheapest for demo) ---
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=deepseek/deepseek-chat
# even cheaper / free alternatives (all support tool calling):
#   deepseek/deepseek-chat-v3-0324:free   (free, rate-limited)
#   meta-llama/llama-3.3-70b-instruct:free (free, rate-limited)
#   z-ai/glm-4.5-air:free                 (free, rate-limited)
#   qwen/qwen3-32b                        (~$0.08/M in, $0.28/M out)

# --- Option B: OpenCode Go (subscription; session header added automatically) ---
# OPENAI_BASE_URL=https://opencode.ai/zen/go/v1
# OPENAI_MODEL=deepseek-v4-pro

# --- Option C: plain OpenAI ---
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

OPENAI_API_KEY=
# extra HTTP headers as JSON, e.g. {"x-opencode-session": "ses_..."} (usually not needed)
OPENAI_EXTRA_HEADERS={}

TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
DEMO_CUSTOMER_ID=CUST00001
JEV_CONFIDENCE_FLOOR=0.7
