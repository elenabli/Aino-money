{
  "name": "aino-money",
  "main": "deploy/worker.js",
  "compatibility_date": "2026-11-14",
  "assets": {
    "directory": "frontend/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*"]
  },
  "containers": [{
    "class_name": "AinoMoneyBackend",
    "scheduling_policy": "durable_object",
    "images": { "base": { "dockerfile": "./deploy/Dockerfile", "build_context": "." } }
  }],
  "durable_objects": {
    "bindings": [{ "name": "BACKEND", "class_name": "AinoMoneyBackend" }]
  },
  "exports": { "AinoMoneyBackend": { "type": "durable-object", "storage": "sqlite" } },
  "vars": { "DEMO_CUSTOMER_ID": "DEMO-SETUKORTTI" }
}
